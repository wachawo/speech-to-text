# STT Server
STT_HOST=0.0.0.0
STT_PORT=5051
STT_TOKENS=
# Instances per model. The Docker compose files read it from here (1 when unset), so every
# instance costs GPU memory: 8 copies of a large model do not fit on most cards.
STT_POOL_SIZE=1
# Seconds a synchronous request (/api/stt, /api/transcript) waits for a free instance of its
# model before it is answered 503. A fraction such as 0.3 suits short phrases.
STT_QUEUE_TIMEOUT=120
# Seconds an idle HTTP connection stays open for the next request (uvicorn; gunicorn's keepalive).
STT_KEEPALIVE_SECONDS=5
STT_DEBUG=false
# Max request body size in megabytes (returns 413 if exceeded)
MAX_CONTENT_LENGTH_MB=100
# CORS allowed origins: "*" or comma-separated list (e.g. https://app.example.com,https://admin.example.com)
CORS_ORIGINS=*
# Gunicorn
GUNICORN_WORKERS=4
# STT Client
STT_METHOD=url
STT_URL=http://localhost:5051
STT_TOKEN=
# LOGGING
LOG_LEVEL=INFO
LOG_ACCESS=false
# Whisper
WHISPER_MODEL=turbo
WHISPER_LANGUAGE=en
WHISPER_DOWNLOAD_ROOT=models
COMPUTE_TYPE=auto
# Beam width of the Whisper decode: 1 is greedy and the fastest; a wider beam is slower,
# slightly more accurate and just as deterministic.
WHISPER_BEAM_SIZE=1
# Half precision on CUDA; false on Pascal cards (Tesla P40), which run fp16 at 1/64 speed.
WHISPER_FP16=true
# Transcription backend: whisper or parakeet. Parakeet needs an image built with
# PARAKEET=true; it covers 25 European languages and detects the language itself, so it
# takes no `language` argument at all - GET /api/models reports that as accepts_language.
STT_BACKEND=whisper
PARAKEET=false
PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v3
PARAKEET_DOWNLOAD_ROOT=models
# Several models side by side, each with its own pool: comma-separated backend:model[@pool].
# Empty keeps the single model chosen above by STT_BACKEND / WHISPER_MODEL / PARAKEET_MODEL.
# Every listed model loads at startup and a request picks one with `model`; memory is
# workers x the sum of the pools. An entry without @pool takes STT_POOL_SIZE (1 above, 8 when
# it is unset outside Docker), so give each entry an explicit @N. STT_DEFAULT_MODEL names the
# model a request without `model` gets; empty means the first entry. A file-path entry is
# served under its file name without .pt; STT_DEFAULT_MODEL takes that name or the path as written.
# STT_MODELS=whisper:turbo@2,parakeet:nvidia/parakeet-tdt-0.6b-v3@1
# STT_DEFAULT_MODEL=

# Speaker diarization (who spoke when; it produces no text on its own).
#
# Two knobs, on purpose. DIARIZE is read by docker compose at BUILD time and decides whether
# the model backend is installed into the image at all. DIARIZE_ENABLED is read by the server
# at RUN time and decides whether /api/diarize answers. Turning the second on without the
# first gives a clean 503 and a log line, not a broken container.
DIARIZE=false
DIARIZE_ENABLED=false
DIARIZE_MODEL=nvidia/Nemotron-3-Diarization
DIARIZE_POOL_SIZE=1
DIARIZE_DOWNLOAD_ROOT=models
DIARIZE_THRESHOLD=0.5

# Speech gate: drop transcribed text nobody spoke (Silero VAD). On by default.
SPEECH_GATE=true

# GPU image build (docker compose only, read at BUILD time like DIARIZE and PARAKEET). Unset, the
# image is the main one: CUDA 13.0 and torch 2.10.0+cu130, for current cards and the GB10.
# A Pascal card such as the Tesla P40 (sm_61) has no kernels in that build: uncomment the block
# below, all five build args together, and run the same `docker compose up -d --build`. The
# container is stt_server as on every other host. fp16 runs at 1/64 speed on Pascal, hence fp32:
# the WHISPER_FP16 line below replaces the one above (the later line wins), or edit that one.
#CUDA_IMAGE=nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04
#CUBLAS_PACKAGE=libcublas-12-6
#TORCH_VERSION=2.9.0
#TORCH_CUDA=cu126
#TORCH_ARCHES=sm_61 sm_60
#WHISPER_FP16=false

# Web UI (docker compose only): the one port of the stt_www container and what it speaks,
# https (the default; a plain http request is redirected) or http. Browsers allow an audio
# device for the DEVICE tab only over https or on localhost.
STT_WWW_PORT=5053
STT_WWW_SCHEME=https

# Docker: run the server as this host user so models/, logs/ and recs/ stay writable to them.
# Unset, the image's own stt user (uid 1001) owns them.
#STT_UID=1000
#STT_GID=1000

# Once every model is in ./models, stop the Hugging Face hub from being asked on every start
# (the diarizer and Parakeet otherwise check it for updates). Leave 0 for the first start.
HF_HUB_OFFLINE=0
