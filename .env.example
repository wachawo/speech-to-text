# STT Server
STT_HOST=0.0.0.0
STT_PORT=5099
STT_TOKENS=
STT_POOL_SIZE=8
STT_DEBUG=false
# Max request body size in megabytes (returns 413 if exceeded)
MAX_CONTENT_LENGTH_MB=10
# CORS allowed origins: "*" or comma-separated list (e.g. https://app.example.com,https://admin.example.com)
CORS_ORIGINS=*
# Gunicorn
GUNICORN_WORKERS=4
# STT Client
STT_METHOD=url
STT_URL=http://localhost:5099
STT_TOKEN=
# LOGGING
LOG_LEVEL=INFO
LOG_ACCESS=false
# Whisper
WHISPER_MODEL=turbo
WHISPER_LANGUAGE=en
WHISPER_DOWNLOAD_ROOT=models
COMPUTE_TYPE=auto
# Transcription backend: whisper or parakeet. Parakeet needs an image built with
# PARAKEET=true; it covers 25 European languages and detects the language itself, so it
# takes no `language` argument at all - GET /api/models reports that as accepts_language.
STT_BACKEND=whisper
PARAKEET=false
PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v3
PARAKEET_DOWNLOAD_ROOT=models
# Several models side by side, each with its own pool: comma-separated backend:model[@pool].
# Empty keeps the single model chosen above by STT_BACKEND / WHISPER_MODEL / PARAKEET_MODEL.
# Every listed model loads at startup and a request picks one with `model`; memory is
# workers x the sum of the pools. An entry without @pool takes STT_POOL_SIZE (8 above, 1 in
# the Docker compose files), so give each entry an explicit @N. STT_DEFAULT_MODEL names the
# model a request without `model` gets; empty means the first entry. A file-path entry is
# served under its file name without .pt; STT_DEFAULT_MODEL takes that name or the path as written.
# STT_MODELS=whisper:turbo@2,parakeet:nvidia/parakeet-tdt-0.6b-v3@1
# STT_DEFAULT_MODEL=

# Speaker diarization (who spoke when; it produces no text on its own).
#
# Two knobs, on purpose. DIARIZE is read by docker compose at BUILD time and decides whether
# the model backend is installed into the image at all. DIARIZE_ENABLED is read by the server
# at RUN time and decides whether /api/diarize answers. Turning the second on without the
# first gives a clean 503 and a log line, not a broken container.
DIARIZE=false
DIARIZE_ENABLED=false
DIARIZE_MODEL=nvidia/Nemotron-3-Diarization
DIARIZE_POOL_SIZE=1
DIARIZE_DOWNLOAD_ROOT=models
DIARIZE_THRESHOLD=0.5
