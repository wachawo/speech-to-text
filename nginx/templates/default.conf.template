# Rendered by the official nginx image entrypoint (envsubst) into
# /etc/nginx/conf.d/default.conf. Only the names present in the container
# environment are substituted, so nginx's own $remote_addr, $uri, $host and the
# rest survive untouched. The substituted names are ${STT_UPSTREAM} and
# ${STT_WWW_TLS_PORT}; both are set by docker-compose.

# The access log mirrors the Python log line of stt_server:
#   YYYY-MM-DD HH:MM:SS.mmm [INFO]: (nginx) client METHOD /path: status
# $time_iso8601 carries a "T" and no milliseconds, $msec is unix seconds with
# three decimals; the two maps splice them together. map is an http-context
# directive, and conf.d is included inside http {}, so it is allowed here.
map $time_iso8601 $unified_date {
    "~^(?<d>\d{4}-\d{2}-\d{2})T(?<t>\d{2}:\d{2}:\d{2})" "$d $t";
    default                                              "$time_iso8601";
}
map $msec $unified_ms {
    "~\.(?<ms>\d{3})$" "$ms";
    default            "000";
}

log_format unified '$unified_date.$unified_ms [INFO]: (nginx) '
                   '$remote_addr $request_method $uri: $status';

upstream stt_upstream {
    server ${STT_UPSTREAM};
    keepalive 32;
}

server {
    listen 80;
    # https on the same server block: browsers allow an audio device only on a
    # secure page or on localhost, so over the LAN live capture must be opened
    # through this listener. The certificate is self-signed by
    # 30-selfsigned-cert.sh unless a real pair is mounted.
    listen 443 ssl;
    ssl_certificate     /etc/nginx/certs/stt.crt;
    ssl_certificate_key /etc/nginx/certs/stt.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    server_name _;
    access_log /var/log/nginx/access.log unified;

    root  /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass http://stt_upstream;

        # Every proxy_set_header lives in this one location, and none at the
        # server level: nginx inherits the server-level set only into a
        # location that defines none of its own. The X-Forwarded-* headers are
        # what stt_server's ProxyFix reads back as the client address and host;
        # HTTP/1.1 plus an empty Connection header is what lets the upstream
        # keepalive above actually be reused.
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;
        proxy_set_header Connection        "";

        # No Authorization header of nginx's own: when stt_server has STT_TOKENS
        # the web UI asks for the token on its sign-in screen and sends it
        # itself, and nginx passes that header through untouched.

        # A long recording takes minutes to transcribe and diarize; the default
        # 60 s would cut the response with a 504 while stt_server is still at it.
        proxy_connect_timeout 5s;
        proxy_send_timeout    600s;
        proxy_read_timeout    600s;

        # The upload goes straight through instead of being spooled to disk
        # first. The cap here is only a backstop: stt_server enforces its own
        # MAX_CONTENT_LENGTH_MB and answers 413 with the limit in the body,
        # which the UI shows, so this one is set well above it.
        proxy_request_buffering off;
        client_max_body_size    512m;

        # stt_server answers JSON, so nginx does the same when stt_server is not
        # there to answer at all - every cold start, since it loads its models
        # before it listens. The UI reads `error` off every failure, and the
        # stock 502 page would land in its error bar as HTML. Only nginx's own
        # 502 and 413: proxy_intercept_errors stays off, so a 503 from a busy
        # pool reaches the browser as stt_server wrote it.
        error_page 502 = @api_down;
        error_page 413 = @too_large;
    }

    location @api_down {
        default_type application/json;
        return 502 '{"error": "The server is not answering; it may still be starting"}';
    }

    location @too_large {
        default_type application/json;
        return 413 '{"error": "Payload Too Large"}';
    }

    # What the UI needs to know about this deployment and cannot ask the API:
    # the https port, for the note that explains why live capture is off on http.
    location = /ui-config.json {
        access_log off;
        default_type application/json;
        add_header Cache-Control "no-cache";
        return 200 '{"tls_port":"${STT_WWW_TLS_PORT}"}';
    }

    # nginx-side liveness for the docker healthcheck, no round trip to the API.
    location = /nginx-healthz {
        access_log off;
        # default_type, not add_header: a return already carries the
        # Content-Type from nginx.conf, and add_header would append a second.
        default_type text/plain;
        return 200 "ok\n";
    }

    # The static UI. no-cache means revalidate, not "do not cache": the browser
    # keeps the file but asks first, and ETag / Last-Modified answer 304 when
    # nothing changed. Without it browsers cache heuristically and a deploy
    # lands half way: a stale screen next to a fresh app.js.
    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }
}
