# Web UI: static Vue 2 files served by nginx, /api/ proxied to stt_server.
# Build context is the repo root (see docker-compose*.yml).
FROM nginx:1.27-alpine

# openssl for the self-signed certificate the entrypoint script below mints
# when none is mounted; the image ships the library but not the tool.
RUN apk add --no-cache openssl

# Main config replaces the bundled one (error_log level, the .vue type, includes).
COPY nginx/nginx.conf /etc/nginx/nginx.conf

# Run with the image's other entrypoint scripts, before nginx: the listener of
# the one UI port, https or http after STT_WWW_SCHEME, and on https a
# certificate unless ./data/certs already holds one.
COPY nginx/25-listen-scheme.sh /docker-entrypoint.d/25-listen-scheme.sh
COPY nginx/30-selfsigned-cert.sh /docker-entrypoint.d/30-selfsigned-cert.sh

# The image entrypoint renders /etc/nginx/templates/*.template into
# /etc/nginx/conf.d/ with envsubst at start, filling in STT_UPSTREAM from the
# container environment.
COPY nginx/templates/ /etc/nginx/templates/

# The UI itself; compose bind-mounts ./www over it for edits without a rebuild.
COPY www/ /usr/share/nginx/html/

# The UI port, https or http; 80 on the loopback is the healthcheck's alone.
EXPOSE 8080
# Entrypoint and CMD stay the image's own: they run the template step, then nginx.
